{
  "name": "@bpmn-io/bpmnlint-generate-docs-images",
  "version": "1.3.0",
  "description": "Generate documentation images for bpmnlint rules",
  "scripts": {
    "all": "npm run test",
    "pretest": "mkdir -p tmp",
    "test": "run-s test:*",
    "test:unit": "node --test test/*.test.js",
    "test:bpmnlint": "(cd tmp && npx degit github:bpmn-io/bpmnlint bpmnlint --force && cd bpmnlint && npm install --omit=dev --ignore-scripts && node ../../cmd.js . --force --verbose --wd ..)",
    "test:example": "(cd tmp && npx degit github:bpmn-io/bpmnlint-plugin-example example --force && node ../cmd.js example --wd .)"
  },
  "bin": "cmd.js",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpmn-io/bpmnlint-generate-docs-images.git"
  },
  "author": {
    "name": "Nico Rehwaldt",
    "url": "https://github.com/nikku"
  },
  "license": "MIT",
  "dependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "bpmn-js": "^18.31.1",
    "bpmn-js-bpmnlint": "^0.25.0",
    "mri": "^1.1.4",
    "rollup": "^4.67.4",
    "rollup-plugin-bpmnlint": "^0.4.1",
    "tiny-glob": "^0.2.6",
    "which": "^6.0.1"
  },
  "devDependencies": {
    "bpmnlint": "^12.0.0",
    "degit": "^3.10.1",
    "npm-run-all2": "^9.0.4",
    "puppeteer-core": "^25.16.0"
  },
  "peerDependencies": {
    "bpmnlint": ">= 10",
    "puppeteer-core": ">= 23"
  },
  "files": [
    "src",
    "cmd.js"
  ]
}
